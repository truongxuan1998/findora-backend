# Findora Backend Environment Configuration (Supabase PostgreSQL)
# Schema: findora (Isolated completely from public schema)
DATABASE_URL=postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:5432/postgres?sslmode=require

PORT=10000
HOST=0.0.0.0
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Supabase Storage Configuration
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_STORAGE_BUCKET=findora_avatar_user

# Upstash Redis Configuration (Free tier: 10,000 commands/day, 256MB)
# 1. Standard Protocol URL for Rust Backend:
REDIS_URL=rediss://default:your_upstash_password@your_endpoint.upstash.io:6379

# 2. REST API Credentials (for Serverless / TypeScript / HTTP):
UPSTASH_REDIS_REST_URL=https://your_endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Resend Transactional Email API (Free: 3,000 emails/month, 100/day)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Findora Security <onboarding@resend.dev>

# Brevo (Sendinblue) Transactional Email API (Free: 300 emails/day)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=Findora Security
